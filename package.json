{
  "name": "elm-pages-app",
  "type": "module",
  "scripts": {
    "postinstall": "elm-tooling install",
    "dev": "dotenvx run -- elm-pages dev",
    "build": "elm-pages build",
    "serve": "dotenvx run -- pnpm build && http-server ./dist -a localhost -p 3000 -c-1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.75.1",
    "elm-codegen": "0.6.3",
    "elm-optimize-level-2": "0.4.0",
    "elm-pages": "3.5.1",
    "elm-review": "2.13.5",
    "elm-tooling": "1.20.0",
    "http-server": "14.1.1",
    "lamdera": "0.19.1-1.4.0",
    "vite": "6.4.3"
  },
  "dependencies": {
    "highlight.js": "11.12.0"
  }
}